generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// User Model
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  username      String    @unique
  password      String
  name          String?
  timezone      String    @default("America/New_York")
  avatar        String?
  bio           String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  accounts      Account[]
  sessions      Session[]
  eventTypes    EventType[]
  bookings      Booking[]
  availability  Availability[]
  calendars     Calendar[]
  selectedCalendars SelectedCalendar[]

  @@index([username])
}

// Account Model (for NextAuth OAuth)
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

// Session Model (for NextAuth)
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// VerificationToken Model (for NextAuth)
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Event Type Model
model EventType {
  id                    String   @id @default(cuid())
  userId                String
  title                 String
  slug                  String
  duration              Int      // in minutes
  description           String?  @db.Text
  locations             Json?    // Array of location options
  bufferTime            Int      @default(0) // in minutes
  minimumBookingNotice  Int      @default(120) // in minutes
  beforeEventBuffer     Int      @default(0)
  afterEventBuffer      Int      @default(0)
  slotInterval          Int?     // Custom slot interval
  requiresConfirmation  Boolean  @default(false)
  disableGuests         Boolean  @default(false)
  hidden                Boolean  @default(false)
  color                 String   @default("#3b82f6")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@unique([userId, slug])
  @@index([userId])
}

enum BookingStatus {
  PENDING
  ACCEPTED
  CANCELLED
  REJECTED
}

// Booking Model
model Booking {
  id                String        @id @default(cuid())
  eventTypeId       String
  userId            String
  startTime         DateTime
  endTime           DateTime
  attendeeName      String
  attendeeEmail     String
  attendeePhone     String?
  attendeeTimezone  String
  attendeeNotes     String?       @db.Text
  status            BookingStatus @default(ACCEPTED)
  cancelReason      String?       @db.Text
  meetingUrl        String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  eventType EventType @relation(fields: [eventTypeId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([eventTypeId])
  @@index([userId])
  @@index([startTime])
  @@index([attendeeEmail])
}

// Availability Model
model Availability {
  id        String   @id @default(cuid())
  userId    String
  days      Int[]    // 0 = Sunday, 1 = Monday, etc.
  startTime String   // HH:mm format
  endTime   String   // HH:mm format
  date      DateTime? // For date-specific overrides
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum CalendarType {
  GOOGLE
  MICROSOFT
  APPLE
}

// Calendar Model (Connected Calendars)
model Calendar {
  id                    String       @id @default(cuid())
  userId                String
  type                  CalendarType
  externalId            String       // Calendar ID from provider
  name                  String?
  primary               Boolean      @default(false)
  integrationAccountId  String?      // Link to Account model
  credentials           Json?        // Encrypted credentials
  refreshToken          String?      @db.Text
  accessToken           String?      @db.Text
  expiresAt             DateTime?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  selectedCalendars SelectedCalendar[]

  @@index([userId])
}

// Selected Calendars for Conflict Checking
model SelectedCalendar {
  id         String   @id @default(cuid())
  userId     String
  calendarId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  calendar Calendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)

  @@unique([userId, calendarId])
  @@index([userId])
}
